generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ USERS / TEAM ============
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         String   @default("AGENT") // ADMIN, MANAGER, AGENT, LIVREUR, BOUTIQUE_OWNER
  active       Boolean  @default(true)
  avatarUrl      String?
  isSuperAdmin   Boolean  @default(false)
  assignedCityId String?
  assignedCity   City?    @relation("AssignedLivreur", fields: [assignedCityId], references: [id])
  subZone        String?  // Commune pour livreurs Conakry (Kaloum, Ratoma, Dixinn...)
  boutiqueId     String?  // Pour le rôle BOUTIQUE_OWNER : boutique associée
  ownedBoutique  Boutique? @relation("BoutiqueOwners", fields: [boutiqueId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ordersAssigned   Order[]       @relation("AssignedAgent")
  deliveries       Delivery[]    @relation("AssignedLivreur")
  callLogs         CallLog[]
  ordersValidated  Order[]       @relation("ValidatedBy")
  teamRequestsMade TeamRequest[] @relation("RequestsMade")
  resetTokens      PasswordResetToken[]
}

// ============ RÉINITIALISATION MOT DE PASSE ============
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // SHA-256 du token envoyé par email (jamais stocké en clair)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ============ BOUTIQUES (SELLERS) ============
model Boutique {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  sellerName  String
  sellerPhone String?
  sellerEmail String?
  website     String?
  webhookKey  String   @unique // clé secrète pour l'endpoint webhook
  active      Boolean  @default(true)

  // ── Import Google Sheets (connecteur type Rapido) ──
  sheetUrl           String?   // URL de la feuille publique (lecteur) fournie par le marchand
  sheetSyncEnabled   Boolean   @default(false) // sync automatique activée
  sheetLastSyncAt    DateTime? // dernière synchro réussie
  sheetLastError     String?   // dernière erreur de synchro (null si OK)
  sheetImportedCount Int       @default(0) // total de commandes importées depuis la feuille
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders           Order[]
  products         Product[]
  merchantInvoices MerchantInvoice[]
  owners           User[]            @relation("BoutiqueOwners")
}

// ============ CLIENTS FINAUX (acheteurs) ============
model Customer {
  id               String    @id @default(cuid())
  fullName         String
  phone            String
  altPhone         String?
  address          String?
  cityId           String?
  city             City?     @relation(fields: [cityId], references: [id])
  commune          String?
  notes            String?
  // ── Blacklist ──
  blacklisted      Boolean   @default(false)
  blacklistReason  String?
  blacklistedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  orders Order[]

  @@index([phone])
  @@index([blacklisted])
}

// ============ VILLES ET ZONES LIVRAISON ============
model City {
  id           String   @id @default(cuid())
  name         String   @unique
  deliveryFee  Float    @default(0)
  estimatedDays Int     @default(1)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  customers        Customer[]
  orders           Order[]
  deliveries       Delivery[]
  assignedLivreurs User[]     @relation("AssignedLivreur")
}

// ============ PRODUITS & STOCK ============
model Product {
  id          String  @id @default(cuid())
  sku         String  @unique
  name        String
  description String?
  price       Float
  costPrice   Float?
  stock       Int     @default(0)
  stockAlert  Int     @default(5)
  imageUrl    String?
  active      Boolean @default(true)
  boutiqueId  String?
  boutique    Boutique? @relation(fields: [boutiqueId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems     OrderItem[]
  stockMovements StockMovement[]
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  type      String   // IN, OUT, ADJUSTMENT, RETURN
  quantity  Int
  reason    String?
  orderId   String?
  createdAt DateTime @default(now())
}

// ============ COMMANDES ============
model Order {
  id               String   @id @default(cuid())
  code             String   @unique // CMD-DDMMYYYY-XXXXX
  boutiqueId       String
  boutique         Boutique @relation(fields: [boutiqueId], references: [id])
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id])
  cityId           String?
  city             City?    @relation(fields: [cityId], references: [id])

  // Status: NOUVEAU, REPORTE, INJOIGNABLE, PDR, CONFIRME, ANNULE, EN_LIVRAISON, LIVRE, RETOURNE
  status           String   @default("NOUVEAU")
  subStatus        String?  // for sub-states like "À rappeler"

  totalAmount      Float
  deliveryFee      Float    @default(0)
  callCount        Int      @default(0)
  notes            String?  // Note interne (ex: "À livrer demain matin")
  reportDate          DateTime? // Date programmée si reporté
  deliveryScheduledAt DateTime? // Heure de livraison promise au client

  assignedAgentId  String?
  assignedAgent    User?    @relation("AssignedAgent", fields: [assignedAgentId], references: [id])

  validatedById    String?
  validatedBy      User?    @relation("ValidatedBy", fields: [validatedById], references: [id])
  validatedAt      DateTime?

  deliveryPaidByClient Boolean @default(false) // true = frais à la charge du client, false = gratuit
  source           String   @default("MANUAL") // MANUAL, WEBHOOK, IMPORT
  externalRef      String?  // ID externe boutique

  // ── Détection de doublons (bug Afrishop) ──
  isDuplicate      Boolean  @default(false) // commande détectée comme doublon → exclue des stats
  duplicateOfCode  String?  // code de la commande d'origine si doublon

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items     OrderItem[]
  delivery  Delivery?
  invoice   Invoice?
  callLogs  CallLog[]

  // Garantit l'unicité de la référence externe par boutique (anti-doublon webhook).
  // En Postgres, les NULL sont distincts → les commandes sans externalRef ne sont pas bloquées.
  @@unique([boutiqueId, externalRef])
  @@index([status])
  @@index([boutiqueId])
  @@index([createdAt])
  @@index([isDuplicate])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  unitPrice Float
  subtotal  Float
}

model CallLog {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  agentId   String
  agent     User     @relation(fields: [agentId], references: [id])
  outcome   String   // ANSWERED, NO_ANSWER, BUSY, REPORTED, CONFIRMED, CANCELLED
  note      String?
  createdAt DateTime @default(now())
}

// ============ LIVRAISONS ============
model Delivery {
  id              String   @id @default(cuid())
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id])
  livreurId       String?
  livreur         User?    @relation("AssignedLivreur", fields: [livreurId], references: [id])
  cityId          String?
  city            City?    @relation(fields: [cityId], references: [id])

  // Status: ASSIGNED, PICKED_UP, IN_TRANSIT, DELIVERED, FAILED, RETURNED
  status          String   @default("ASSIGNED")

  scheduledAt     DateTime?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?

  amountCollected   Float?
  originalAmount    Float?   // montant initial avant modification
  amountEditNote    String?  // raison de la modification
  amountEditedById  String?  // admin/superviseur ayant modifié
  amountEditedAt    DateTime?
  failureReason     String?
  notes             String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============ FACTURES & DEPENSES ============
model Invoice {
  id          String   @id @default(cuid())
  reference   String   @unique // FACT-YYYYMMDD-XXXXX
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])

  subtotal    Float
  deliveryFee Float    @default(0)
  discount    Float    @default(0)
  tax         Float    @default(0)
  total       Float

  status      String   @default("EMISE") // EMISE, PAYEE, ANNULEE
  paidAt      DateTime?
  pdfUrl      String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ FACTURES MARCHANDS (periodiques, pour le commerçant) ============
model MerchantInvoice {
  id           String   @id @default(cuid())
  reference    String   @unique // FACM-YYYYMMDD-XXXXX
  boutiqueId   String
  boutique     Boutique @relation(fields: [boutiqueId], references: [id])
  periodStart  DateTime
  periodEnd    DateTime
  orderCount   Int      @default(0)
  productCount Int      @default(0)
  totalGross   Float    @default(0) // total collecté (produits + livraison) au tarif validé
  totalProducts Float   @default(0) // total produits seuls (sans frais livraison)
  fraisHMP     Float    @default(0) // 70000 × orderCount
  netMarchand  Float    @default(0) // totalProducts - fraisHMP
  status       String   @default("EN_ATTENTE") // EN_ATTENTE, PAYEE, ANNULEE
  paidAt       DateTime?
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([boutiqueId, periodStart]) // F1 — empêche doublons en cas de génération simultanée
}

model Expense {
  id          String   @id @default(cuid())
  reference   String   @unique
  category    String   // SALAIRE, LOYER, TRANSPORT, MARKETING, AUTRE
  description String
  amount      Float
  date        DateTime
  paidTo      String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ NOTIFICATIONS ADMIN ============
model Notification {
  id        String   @id @default(cuid())
  userId    String?  // null = admin global, sinon ciblé à un utilisateur précis
  type      String   // ORDER_ASSIGNED, ORDER_CONFIRMED, ORDER_DELIVERED, AMOUNT_EDITED, etc.
  title     String
  message   String
  data      String?  // JSON optionnel { orderId, ... }
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
}

// ============ DEMANDES D'ÉQUIPE (superviseur → admin) ============
model TeamRequest {
  id            String    @id @default(cuid())
  type          String    // CREATE_AGENT, DELETE_AGENT
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedById String
  requestedBy   User      @relation("RequestsMade", fields: [requestedById], references: [id])
  targetUserId  String?   // Pour DELETE_AGENT : l'agent à supprimer
  targetName    String?   // Nom de l'agent ciblé (snapshot au moment de la demande)
  requestData   String?   // JSON pour CREATE_AGENT : {firstName, lastName, email, phone, password, role}
  adminNote     String?   // Note de l'admin lors du rejet
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

// ============ PARAMETRES ============
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ============ JOURNAL D'AUDIT ============
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  action    String   // ORDER_DELETED, AMOUNT_EDITED, RESET_EXECUTED
  entity    String?
  entityId  String?
  details   String?  // JSON sérialisé
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

// ============ JOURNAL D'INGESTION WEBHOOK ============
// Trace chaque commande reçue via /api/webhook/order : utile pour diagnostiquer
// les doublons Afrishop et auditer le flux entrant boutique → CRM.
model WebhookLog {
  id           String   @id @default(cuid())
  boutiqueId   String?  // null si la clé webhook n'a pas été reconnue
  boutiqueName String?
  externalRef  String?  // référence commande côté boutique
  phone        String?  // téléphone du client (si présent dans le payload)
  outcome      String   // CREATED, DUPLICATE_EXTERNAL_REF, DUPLICATE_ACTIVE_FLAGGED, BLACKLISTED, ERROR
  orderCode    String?  // code de la commande créée ou existante
  statusCode   Int      // code HTTP renvoyé
  bodySize     Int      @default(0) // taille du payload reçu (octets)
  ip           String?  // IP source (x-forwarded-for)
  error        String?  // message d'erreur si outcome=ERROR
  createdAt    DateTime @default(now())

  @@index([boutiqueId])
  @@index([externalRef])
  @@index([outcome])
  @@index([createdAt])
}
